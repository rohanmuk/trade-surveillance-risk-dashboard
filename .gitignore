# .vscode/settings.json IS tracked -- it points Pylance and the test runner at
# the project's own .venv, which is what stops "Import could not be resolved"
# warnings on a fresh clone. Other .vscode files stay local.
.vscode/*
!.vscode/settings.json

# --- Secrets --------------------------------------------------------------
.env
.env.*

# --- Generated exports ----------------------------------------------------
# Ad-hoc CSVs downloaded from the dashboard.
trade_exceptions.csv
trades_filtered.csv

# NOTE: data/simulated_trades.csv is deliberately NOT ignored. It is the
# committed sample dataset the dashboard and notebook run against, and it is
# fully synthetic (see scripts/generate_trades.py).
